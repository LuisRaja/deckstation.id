# --- EMAIL (Gmail SMTP) ---
# 1. Buka https://myaccount.google.com/apppasswords
# 2. Login dengan email PENGIRIM (yang akan dipakai ngirim email)
# 3. Pilih "Mail" + "Other" (beri nama "DeckStation")
# 4. Copy 16 digit App Password
# 5. Isi di bawah:

EMAIL_SENDER=email.anda@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECEIVER_1=kenapayaa86@gmail.com

# --- GOOGLE CALENDAR API ---
# 1. Buka https://console.cloud.google.com/
# 2. Buat project baru > "DeckStation Booking"
# 3. Enable "Google Calendar API"
# 4. IAM & Admin > Service Accounts > Buat Service Account
# 5. Download JSON key
# 6. Rename jadi credentials.json & taruh di folder project
# 7. Bagikan calendar Anda ke email service account tersebut
# 8. Isi Calendar ID (biasanya email Anda atau format khusus)

GOOGLE_CALENDAR_ID=primary
# atau ganti dengan calendar ID spesifik

# --- FLASK ---
SECRET_KEY=your-secret-key-here-change-in-production
